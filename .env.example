# Canonical site URL (no trailing slash). Used for sitemap, Open Graph, JSON-LD,
# and Ask AI origin allowlisting. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://richard-rinaldy.vercel.app

# Required for the "Ask AI" chatbot (Google Gemini via Vercel AI SDK).
# Get a key from https://aistudio.google.com/app/apikey — keep this secret.
GOOGLE_GENERATIVE_AI_API_KEY=

# Kill switch for Ask AI. Set to false to pause the terminal without removing UI chrome.
# Default (unset) = enabled.
CHAT_ENABLED=true
